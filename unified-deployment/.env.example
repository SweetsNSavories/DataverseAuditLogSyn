# ===========================================================================
# Dataverse Audit Sync - Environment Variables
# Copy this file to `.env` and fill in your values
# ===========================================================================

# ----- Dataverse Connection -----
DATAVERSE_ORG_URL=https://yourorg.crm.dynamics.com
CLIENT_ID=your-app-registration-client-id
CLIENT_SECRET=your-client-secret

# ----- Snowflake Connection -----
SNOWFLAKE_USER=your-snowflake-user
SNOWFLAKE_PASSWORD=your-snowflake-password
SNOWFLAKE_ACCOUNT=your-account.region
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AUDIT_DB
SNOWFLAKE_SCHEMA=PUBLIC

# ----- Optional: Filter to single entity (for parallel containers) -----
# ENTITY=Account

# ----- Optional: Backfill from a specific date -----
# OVERRIDE_START_TIME=2026-01-01T00:00:00
